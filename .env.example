VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SITE_URL=https://themazzy.github.io/arcanevault
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
STRIPE_PREMIUM_PRICE_ID=price_your-one-time-premium-themes-price

# Cloudflare Web Analytics beacon site token (public; safe in the client bundle).
# LEAVE THIS UNSET while Cloudflare's automatic injection is enabled for the zone
# (Web Analytics -> Manage site -> "Enable"), which is the current setup: adding
# the snippet on top of auto-injection double-counts every page view. Only set it
# after switching that setting to "Enable with JS Snippet installation".
VITE_CF_BEACON_TOKEN=

# Cloudflare analytics API credentials for the /admin Traffic tab. These are
# NOT client env vars - they are Supabase Edge Function secrets, set with:
#   npx supabase secrets set CF_API_TOKEN=... CF_ACCOUNT_ID=... CF_ZONE_ID=...
# CF_API_TOKEN needs Account Analytics:Read + Zone Analytics:Read, nothing else.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# Both optional. The site tag is discovered from the account's RUM site list,
# matched against CF_RUM_HOST (default deckloom.app). Set CF_RUM_SITE_TAG only to
# pin a specific site - and note it is site_tag, NOT the snippet's site_token.
CF_RUM_SITE_TAG=
CF_RUM_HOST=
