{
  "appId": "com.arcanevault.app",
  "appName": "Deck Loom",
  "webDir": "dist",
  "backgroundColor": "#00000000",
  "server": {
    "url": "https://deckloom.app",
    "cleartext": false
  },
  "plugins": {
    "BackgroundRunner": {
      "label": "app.deckloom.pricealerts",
      "src": "runners/price-alerts.js",
      "event": "checkPriceMoves",
      "repeat": true,
      "interval": 360,
      "autoStart": true
    }
  }
}
